<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: simple solid black circle.
     108dp canvas with a 64dp-diameter circle (r=32) centered at (54,54),
     which stays inside Android's 66dp-diameter icon safe zone so launcher
     masks (circle, squircle, etc.) never crop it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FF000000"
        android:pathData="M54,54m-32,0a32,32 0,1 1,64 0a32,32 0,1 1,-64 0" />
</vector>
